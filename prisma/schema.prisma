
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum EntityType {
  COMPANY
  PRODUCT
  SERVICE
  TECHNOLOGY
  OTHER
}

model User {
  id          String         @id @default(cuid())
  email       String?        @unique
  displayName String?
  timezone    String         @default("UTC")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  conversations Conversation[]
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New conversation")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages         Message[]
  researchSessions ResearchSession[]
  searchLogs       SearchLog[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ResearchSession {
  id             String         @id @default(cuid())
  conversationId String
  topic          String
  summary        String?        @db.Text
  status         ResearchStatus @default(IN_PROGRESS)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  entities     ResearchSessionEntity[]
  facts        ResearchFact[]
  sources      Source[]
  searchLogs   SearchLog[]

  @@index([conversationId, startedAt])
  @@index([topic])
}

model Entity {
  id            String     @id @default(cuid())
  name          String
  canonicalName String
  type          EntityType @default(OTHER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  researchSessions ResearchSessionEntity[]
  facts            ResearchFact[]

  @@unique([canonicalName, type])
  @@index([canonicalName])
}

model ResearchSessionEntity {
  id                String @id @default(cuid())
  researchSessionId String
  entityId          String

  researchSession ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([researchSessionId, entityId])
  @@index([entityId])
}

model ResearchFact {
  id                String   @id @default(cuid())
  researchSessionId String
  entityId          String
  sourceId          String?

  attribute        String
  value            Json
  normalizedValue  String?
  unit             String?
  currency         String?
  effectiveAt      DateTime?
  observedAt       DateTime @default(now())
  confidence       Float?
  notes            String?  @db.Text

  researchSession ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source          Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([entityId, attribute, observedAt])
  @@index([researchSessionId])
  @@index([sourceId])
}

model Source {
  id                String   @id @default(cuid())
  researchSessionId String?
  searchLogId       String?

  title        String
  url          String
  domain       String?
  snippet      String?  @db.Text
  publishedAt  DateTime?
  retrievedAt  DateTime @default(now())
  contentHash  String?

  researchSession ResearchSession? @relation(fields: [researchSessionId], references: [id], onDelete: SetNull)
  searchLog       SearchLog?       @relation(fields: [searchLogId], references: [id], onDelete: SetNull)
  facts           ResearchFact[]

  @@index([researchSessionId])
  @@index([searchLogId])
  @@index([retrievedAt])
  @@index([url])
}

model SearchLog {
  id                String   @id @default(cuid())
  conversationId    String?
  researchSessionId String?

  query       String
  provider    String   @default("tavily")
  status      String   @default("SUCCESS")
  resultCount Int      @default(0)
  durationMs  Int?
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  conversation    Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  researchSession ResearchSession? @relation(fields: [researchSessionId], references: [id], onDelete: SetNull)
  sources         Source[]

  @@index([conversationId, createdAt])
  @@index([researchSessionId])
}
